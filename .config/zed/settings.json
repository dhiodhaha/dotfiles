{
  "base_keymap": "VSCode",
  "vim_mode": true,
  "theme": "One Dark",
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 14,
  "ui_font_size": 15,
  "tab_size": 2,
  "hard_tabs": false,
  "format_on_save": "on",
  "autosave": "on_focus_change",
  "relative_line_numbers": true,
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "terminal": {
    "shell": {
      "program": "/usr/bin/zsh"
    },
    "working_directory": "current_project_directory",
    "env": {
      "EDITOR": "nvim",
      "VISUAL": "nvim"
    }
  },
  "languages": {
    "JavaScript": {
      "formatter": "prettier"
    },
    "TypeScript": {
      "formatter": "prettier"
    },
    "TSX": {
      "formatter": "prettier"
    },
    "JSON": {
      "formatter": "prettier"
    },
    "Markdown": {
      "format_on_save": "on"
    }
  }
}
