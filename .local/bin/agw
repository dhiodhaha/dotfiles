#!/usr/bin/env bash
set -euo pipefail

app="/mnt/c/Users/dopamine/AppData/Local/Programs/Antigravity/Antigravity.exe"
distro="${WSL_DISTRO_NAME:-Ubuntu}"

if [[ ! -x "$app" ]]; then
  printf 'agw is WSL/Windows-only. Antigravity.exe was not found at:\n%s\n' "$app" >&2
  exit 1
fi

if [[ $# -eq 0 ]]; then
  set -- .
fi

args=()
for arg in "$@"; do
  if [[ "$arg" == -* ]]; then
    args+=("$arg")
  elif [[ -e "$arg" ]]; then
    args+=("$(realpath "$arg")")
  else
    args+=("$arg")
  fi
done

exec "$app" --remote "wsl+${distro}" "${args[@]}"
